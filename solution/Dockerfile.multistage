FROM public.ecr.aws/docker/library/golang:1.26-alpine@sha256:ecb67f987aa1a57794c91d19ade7ae0209f2f0f5496aaef9e6ae85ddf92d02ab AS build

WORKDIR /app

COPY go.* ./
RUN go mod download

COPY main.go main.go
RUN CGO_ENABLED=0 go build -o=main

# =====================================================

FROM scratch AS production

# Copy app and front
WORKDIR /app
COPY ./public public

COPY --from=build /app/main /main

EXPOSE 3000
ENTRYPOINT ["/main"]
